+#[cfg(test)]
+mod strict_windows_path_tests {
+    use super::*;
+
+    #[test]
+    fn local_lexical_admission_accepts_only_unambiguous_drive_paths() {
+        for path in [r"C:\fixed path\child.exe", r"\\?\C:\fixed\child.exe"] {
+            let (drive, parts) = local_executable_parts(std::ffi::OsStr::new(path)).unwrap();
+            assert_eq!(drive, u16::from(b'C'));
+            assert!(!parts.is_empty());
+        }
+        for path in [
+            r"\\server\share\child.exe",
+            r"\\?\UNC\server\share\child.exe",
+            r"\\.\pipe\child",
+            r"\\?\GLOBALROOT\Device\HarddiskVolume3\child.exe",
+            r"C:\fixed\child.exe:stream",
+            r"C:\fixed\..\child.exe",
+            r"C:\fixed.\child.exe",
+            r"C:\fixed \child.exe",
+            r"C:/fixed/child.exe",
+            r"C:child.exe",
+            r"C:\fixed\NUL.exe",
+            r"C:\fixed\COM¹.exe",
+            r"C:\",
+        ] {
+            assert!(
+                local_executable_parts(std::ffi::OsStr::new(path)).is_err(),
+                "{path}"
+            );
+        }
+    }
+
+    #[test]
+    fn native_local_file_custody_holds_image_against_write_without_spawning() {
+        let directory = tempfile::tempdir().unwrap();
+        let image = directory.path().join("fixed-not-executed.exe");
+        std::fs::write(&image, b"fixed public file; never executed").unwrap();
+        drop(
+            std::fs::OpenOptions::new()
+                .write(true)
+                .open(&image)
+                .unwrap(),
+        );
+        let custody = pin_local_executable(image.as_os_str()).unwrap();
+        let error = std::fs::OpenOptions::new()
+            .write(true)
+            .open(&image)
+            .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(32)); // ERROR_SHARING_VIOLATION
+        assert!(String::from_utf16_lossy(&custody.application).starts_with(r"\\?\Volume{"));
+        drop(custody);
+        drop(
+            std::fs::OpenOptions::new()
+                .write(true)
+                .open(&image)
+                .unwrap(),
+        );
+    }
+}
