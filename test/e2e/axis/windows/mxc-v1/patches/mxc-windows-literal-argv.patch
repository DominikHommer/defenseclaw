+/// Encode the documented Windows C/Rust argv rules without invoking a shell.
+/// Keep the absolute application separate so CreateProcessW never searches or
+/// guesses which executable a command-line prefix names.
+fn windows_literal_argv_buffers(
+    argv: &crate::mxc_common::literal_argv::LiteralArgv,
+) -> Result<(Vec<u16>, Vec<u16>), ScriptResponse> {
+    use std::os::windows::ffi::OsStrExt;
+    const MAX_COMMAND_UNITS: usize = 32_766; // excludes the terminating NUL
+    fn append(output: &mut Vec<u16>, unit: u16, count: usize) -> Result<(), ScriptResponse> {
+        if output
+            .len()
+            .checked_add(count)
+            .is_none_or(|size| size > MAX_COMMAND_UNITS)
+        {
+            return Err(ScriptResponse::rejected(
+                "literal Windows command exceeds 32767 UTF-16 units",
+            ));
+        }
+        output.extend(std::iter::repeat_n(unit, count));
+        Ok(())
+    }
+    let mut application: Vec<u16> = argv.program().encode_wide().collect();
+    if application.contains(&0) || application.contains(&u16::from(b'"')) {
+        return Err(ScriptResponse::rejected(
+            "literal Windows executable contains NUL or a quote",
+        ));
+    }
+    let mut command = Vec::new();
+    for (index, value) in argv.values().iter().enumerate() {
+        if index != 0 {
+            append(&mut command, u16::from(b' '), 1)?;
+        }
+        append(&mut command, u16::from(b'"'), 1)?;
+        let mut slashes = 0;
+        for unit in value.encode_wide() {
+            if unit == 0 {
+                return Err(ScriptResponse::rejected(
+                    "literal Windows argument contains NUL",
+                ));
+            }
+            if unit == u16::from(b'\\') {
+                slashes += 1;
+                continue;
+            }
+            if unit == u16::from(b'"') {
+                append(&mut command, u16::from(b'\\'), slashes * 2 + 1)?;
+            } else {
+                append(&mut command, u16::from(b'\\'), slashes)?;
+            }
+            append(&mut command, unit, 1)?;
+            slashes = 0;
+        }
+        append(&mut command, u16::from(b'\\'), slashes * 2)?;
+        append(&mut command, u16::from(b'"'), 1)?;
+    }
+    application.push(0);
+    command.push(0);
+    Ok((application, command))
+}
