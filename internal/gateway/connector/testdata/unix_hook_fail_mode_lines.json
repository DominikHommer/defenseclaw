{
  "claude-code-hook.sh/closed": [
    "  _DC_HOME_FAIL_MODE=\"closed\"",
    "  case \"${DEFENSECLAW_STRICT_AVAILABILITY:-}\" in 1|true|TRUE|yes|YES) _DC_HOME_FAIL_MODE=\"closed\" ;; esac",
    "FAIL_MODE=\"closed\""
  ],
  "claude-code-hook.sh/open": [
    "  _DC_HOME_FAIL_MODE=\"open\"",
    "  case \"${DEFENSECLAW_STRICT_AVAILABILITY:-}\" in 1|true|TRUE|yes|YES) _DC_HOME_FAIL_MODE=\"closed\" ;; esac",
    "FAIL_MODE=\"open\""
  ],
