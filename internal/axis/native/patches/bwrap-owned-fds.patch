 static void
+owned_fd_mount (int source_fd, const char *destination, bool readonly)
+{
+  cleanup_fd int current_ns = -1;
+  cleanup_fd int root_fd = -1;
+  cleanup_fd int parent_fd = -1;
+  cleanup_fd int target_fd = -1;
+  cleanup_fd int tree_fd = -1;
+  cleanup_free char *relative = NULL;
+  struct stat original_ns, active_ns, source_st, target_st, root_st, parent_st;
+  struct statfs root_fs;
+  struct mount_attr attr = { 0 };
+  char *component, *next;
+  unsigned tree_flags = OPEN_TREE_CLONE | OPEN_TREE_CLOEXEC | AT_EMPTY_PATH | AT_NO_AUTOMOUNT;
+  unsigned attr_flags = AT_EMPTY_PATH;
+
+  /* All mutation below must be in bwrap's newly created mount namespace.
+   * Keep the original namespace alive: an inode must not be compared after
+   * releasing the object whose identity it represents. */
+  current_ns = openat (proc_fd, "self/ns/mnt", O_RDONLY | O_CLOEXEC);
+  if (original_mount_ns_fd < 0 || current_ns < 0 ||
+      fstat (original_mount_ns_fd, &original_ns) != 0 ||
+      fstat (current_ns, &active_ns) != 0 ||
+      (original_ns.st_dev == active_ns.st_dev && original_ns.st_ino == active_ns.st_ino))
+    die ("Owned FD mounts require a new private mount namespace");
+
+  if (fstat (source_fd, &source_st) != 0 ||
+      (!S_ISDIR (source_st.st_mode) && !S_ISREG (source_st.st_mode)))
+    die ("Owned FD mount source must be an open directory or regular file");
+  if (destination == NULL || destination[0] != '/' || destination[1] == 0 ||
+      destination[strlen (destination) - 1] == '/' ||
+      has_path_prefix (destination, "/dev") || has_path_prefix (destination, "/proc"))
+    die ("Owned FD mount destination must be a normalized non-root absolute path");
+
+  root_fd = open ("/newroot", O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (root_fd < 0 || fstat (root_fd, &root_st) != 0 ||
+      fstatfs (root_fd, &root_fs) != 0 || root_fs.f_type != TMPFS_MAGIC)
+    die ("Owned FD mount destination root is not bwrap's private tmpfs");
+  parent_fd = fcntl (root_fd, F_DUPFD_CLOEXEC, 3);
+  if (parent_fd < 0)
+    die_with_error ("Can't retain owned destination root");
+
+  relative = xstrdup (destination + 1);
+  component = relative;
+  for (;;)
+    {
+      bool is_directory;
+      next = strchr (component, '/');
+      if (next != NULL)
+        *next = 0;
+      if (component[0] == 0 || strcmp (component, ".") == 0 || strcmp (component, "..") == 0)
+        die ("Owned FD mount destination has an invalid component");
+      if (fstat (parent_fd, &parent_st) != 0)
+        die_with_error ("Can't inspect owned destination parent");
+      is_directory = next != NULL || S_ISDIR (source_st.st_mode);
+      /* An earlier mount may cover a destination ancestor. Never create a
+       * placeholder in that source filesystem: only this new private tmpfs
+       * may be changed. Existing targets remain usable through held FDs. */
+      if (parent_st.st_dev == root_st.st_dev && is_directory)
+        {
+          if (mkdirat (parent_fd, component, 0755) != 0 && errno != EEXIST)
+            die_with_error ("Can't create owned destination directory");
+        }
+      else if (parent_st.st_dev == root_st.st_dev)
+        {
+          cleanup_fd int created = openat (parent_fd, component,
+                                          O_CREAT | O_EXCL | O_RDONLY | O_NOFOLLOW | O_CLOEXEC, 0444);
+          if (created < 0 && errno != EEXIST)
+            die_with_error ("Can't create owned destination file");
+        }
+      target_fd = openat (parent_fd, component, O_PATH | O_NOFOLLOW | O_CLOEXEC |
+                          (is_directory ? O_DIRECTORY : 0));
+      if (target_fd < 0 || fstat (target_fd, &target_st) != 0 ||
+          (is_directory ? !S_ISDIR (target_st.st_mode) : !S_ISREG (target_st.st_mode)))
+        die ("Owned FD mount destination is not an admitted object");
+      if (next == NULL)
+        break;
+      close (parent_fd);
+      parent_fd = target_fd;
+      target_fd = -1;
+      component = next + 1;
+    }
+
+  /* These operations act on the held source and a detached clone only. There
+   * is no source pathname, realpath conversion, or change to the source mount.
+   * Directory clones and attributes must include every existing submount. */
+  if (S_ISDIR (source_st.st_mode))
+    {
+      tree_flags |= AT_RECURSIVE;
+      attr_flags |= AT_RECURSIVE;
+    }
+  tree_fd = syscall (SYS_open_tree, source_fd, "", tree_flags);
+  if (tree_fd < 0)
+    die_with_error ("Owned source mount cloning failed");
+  attr.attr_set = MOUNT_ATTR_NOSUID | MOUNT_ATTR_NODEV | (readonly ? MOUNT_ATTR_RDONLY : 0);
+  if (syscall (SYS_mount_setattr, tree_fd, "", attr_flags, &attr, sizeof (attr)) != 0)
+    die_with_error ("Owned detached mount attributes failed");
+  if (syscall (SYS_move_mount, tree_fd, "", target_fd, "",
+               MOVE_MOUNT_F_EMPTY_PATH | MOVE_MOUNT_T_EMPTY_PATH) != 0)
+    die_with_error ("Owned mount attachment failed");
+}
