+/// Separate contributor-only hook transport variant. The caller must prove a
+/// per-session, held Unix listener-directory capability before selecting this
+/// exporter; this function itself grants no filesystem or binding authority.
+/// socket(AF_UNIX) and connect remain available, while socketpair and every
+/// non-Unix socket domain return EPERM. The offline exporter above is unchanged.
+pub fn export_unix_hook_mxc_bpf(policy: &ProcessPolicy) -> Result<Vec<u8>, String> {
+    if policy
+        .blocked_syscalls
+        .iter()
+        .any(|name| name == "socket" || name == "connect")
+    {
+        return Err("hook socket conflicts with blocked syscall".into());
+    }
+    let mut policy = policy.clone();
+    if !policy.blocked_syscalls.iter().any(|name| name == "socketpair") {
+        policy.blocked_syscalls.push("socketpair".into());
+    }
+    let filter =
+        prepare_seccomp_with_options(&policy, SeccompOptions::deny_network_socket_domains())?;
+    Ok(filter.export_bpf_bytes())
+}
