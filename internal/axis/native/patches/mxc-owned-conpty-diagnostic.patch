+#[cfg(feature = "axis-conpty-diagnostic")]
+impl OwnedPsecProcess {
+    pub fn finish_diagnostic_console_attach(&mut self) -> std::io::Result<()> {
+        if let Some(terminal) = self.terminal.as_mut() {
+            terminal.attached()?;
+        }
+        Ok(())
+    }
+    pub fn resize_diagnostic_console(&mut self, rows: u16, columns: u16) -> std::io::Result<()> {
+        if self.start != OwnedPsecStart::Running || self.stop_requested || self.code.is_some() {
+            return Err(std::io::Error::other("console diagnostic is not running"));
+        }
+        self.terminal
+            .as_ref()
+            .ok_or_else(|| std::io::Error::other("console diagnostic absent"))?
+            .resize(rows, columns)
+    }
+}
+#[cfg(feature = "axis-conpty-diagnostic")]
+impl BaseContainerRunner {
+    pub(crate) fn spawn_owned_diagnostic_suspended(
+        &mut self,
+        request: ExecutionRequest,
+        argv: crate::mxc_common::literal_argv::LiteralArgv,
+        custody: LocalExecutableCustody,
+        files: Vec<std::fs::File>,
+        case: crate::owned_windows_conpty_diagnostic::OwnedWindowsDiagnosticCase,
+        io: crate::owned_windows_conpty_diagnostic::OwnedWindowsDiagnosticIo,
+    ) -> std::io::Result<OwnedPsecProcess> {
+        use crate::owned_windows_conpty_diagnostic::{DiagnosticLaunch, OwnedWindowsDiagnosticIo};
+        let (stdio, terminal) = match io {
+            OwnedWindowsDiagnosticIo::Headless(stdio) => (Some(stdio), None),
+            OwnedWindowsDiagnosticIo::Terminal(terminal) => (None, Some(terminal)),
+        };
+        let control = DiagnosticLaunch::new(case, terminal.as_ref())?;
+        let result = (|| {
+            crate::mxc_common::validator::validate_argv_common(&request, &argv)?;
+            if case.uses_psec() {
+                self.validate(&request)?;
+            }
+            windows_literal_argv_buffers(&argv)?;
+            if let Some(stdio) = stdio.as_ref() {
+                crate::owned_windows_psec::validate_stdio(stdio)
+                    .map_err(|_| ScriptResponse::rejected("fixed diagnostic stdio refused"))?;
+            }
+            let mut logger = Logger::new(crate::mxc_common::logger::Mode::Buffer);
+            self.spawn_base(
+                &request,
+                &mut logger,
+                false,
+                Some(&argv),
+                Some(&custody),
+                stdio.as_ref(),
+                true,
+                Some(&control),
+            )
+        })();
+        let child = result
+            .map_err(|_private_sdk_response: ScriptResponse| control.failure.get().error())?;
+        drop(control);
+        Ok(OwnedPsecProcess {
+            child,
+            start: OwnedPsecStart::Suspended,
+            resume_custody: Some(custody),
+            _files: files,
+            stop_requested: false,
+            code: None,
+            terminal,
+        })
+    }
+}
