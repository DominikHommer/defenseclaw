+// Copyright 2026 Cisco Systems, Inc. and its affiliates
+// SPDX-License-Identifier: MIT
+
+//! Source-only fixed diagnostic. No customer terminal or fallback capability.
+//! The separate Cargo feature is off by default. OrdinaryConpty deliberately
+//! omits PSEC and must never be represented as a contained workload.
+use crate::owned_windows_psec::{OwnedWindowsStdio, validate_pipe_endpoint};
+use std::cell::Cell;
+use std::ffi::c_void;
+use std::io;
+use std::os::windows::io::{AsRawHandle, IntoRawHandle, OwnedHandle};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OwnedWindowsDiagnosticCase {
+    OrdinaryConpty,
+    HeadlessPsec,
+    ConptyPsec,
+}
+impl OwnedWindowsDiagnosticCase {
+    pub fn uses_psec(self) -> bool {
+        self != Self::OrdinaryConpty
+    }
+    pub fn uses_conpty(self) -> bool {
+        self != Self::HeadlessPsec
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OwnedWindowsDiagnosticStage {
+    Input,
+    HostVersion,
+    ConsoleEndpoints,
+    ConsoleCreate,
+    PsecVersion,
+    PsecCreate,
+    StartupAttributes,
+    CreateProcess,
+    JobAssignment,
+    ReturnedSuspended,
+    ConsoleAttach,
+    ConsoleResize,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct OwnedWindowsDiagnosticFailure {
+    pub stage: OwnedWindowsDiagnosticStage,
+    pub hresult: Option<i32>,
+    pub win32: Option<u32>,
+    pub nt_status: Option<u32>,
+}
+impl OwnedWindowsDiagnosticFailure {
+    pub(crate) fn at(stage: OwnedWindowsDiagnosticStage) -> Self {
+        Self {
+            stage,
+            hresult: None,
+            win32: None,
+            nt_status: None,
+        }
+    }
+    pub(crate) fn error(self) -> io::Error {
+        io::Error::other(self)
+    }
+    pub fn from_error(error: &io::Error) -> Option<Self> {
+        error.get_ref()?.downcast_ref::<Self>().copied()
+    }
+}
+impl std::fmt::Display for OwnedWindowsDiagnosticFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("owned Windows console diagnostic refused")
+    }
+}
+impl std::error::Error for OwnedWindowsDiagnosticFailure {}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Coord {
+    x: i16,
+    y: i16,
+}
+#[repr(C)]
+struct Version {
+    size: u32,
+    major: u32,
+    minor: u32,
+    build: u32,
+    platform: u32,
+    service_pack: [u16; 128],
+}
+const _: () = assert!(std::mem::size_of::<Coord>() == 4);
+const _: () = assert!(std::mem::size_of::<Version>() == 276);
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn CreatePseudoConsole(
+        size: Coord,
+        input: *mut c_void,
+        output: *mut c_void,
+        flags: u32,
+        console: *mut isize,
+    ) -> i32;
+    fn ResizePseudoConsole(console: isize, size: Coord) -> i32;
+    fn ClosePseudoConsole(console: isize);
+    fn CloseHandle(handle: *mut c_void) -> i32;
+    fn SetHandleInformation(handle: *mut c_void, mask: u32, flags: u32) -> i32;
+    fn ExitProcess(code: u32) -> !;
+}
+#[link(name = "ntdll")]
+unsafe extern "system" {
+    fn RtlGetVersion(version: *mut Version) -> i32;
+}
+fn dimensions(rows: u16, columns: u16) -> io::Result<Coord> {
+    // Small fixed diagnostic frames, not a general terminal size API.
+    if !(1..=256).contains(&rows) || !(1..=256).contains(&columns) {
+        return Err(OwnedWindowsDiagnosticFailure::at(OwnedWindowsDiagnosticStage::Input).error());
+    }
+    Ok(Coord {
+        x: columns as i16,
+        y: rows as i16,
+    })
+}
+fn supported_close_version(major: u32, build: u32) -> bool {
+    major == 10 && build >= 26100
+}
+fn require_bounded_close_host() -> io::Result<()> {
+    let mut version: Version = unsafe { std::mem::zeroed() };
+    version.size = std::mem::size_of::<Version>() as u32;
+    if unsafe { RtlGetVersion(&mut version) } != 0
+        || !supported_close_version(version.major, version.build)
+    {
+        return Err(
+            OwnedWindowsDiagnosticFailure::at(OwnedWindowsDiagnosticStage::HostVersion).error(),
+        );
+    }
+    Ok(())
+}
+// Newly added native closures are checked. An uncertain close cannot become a
+// successful diagnostic; fatal private-peer exit leaves the outer Job in charge.
+struct Endpoint(Option<OwnedHandle>);
+impl Endpoint {
+    fn raw(&self) -> *mut c_void {
+        self.0
+            .as_ref()
+            .map_or(std::ptr::null_mut(), AsRawHandle::as_raw_handle)
+    }
+    fn close(&mut self) {
+        if let Some(handle) = self.0.take() {
+            if unsafe { CloseHandle(handle.into_raw_handle()) } == 0 {
+                unsafe { ExitProcess(70) }
+            }
+        }
+    }
+}
+impl Drop for Endpoint {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+pub struct OwnedWindowsTerminal {
+    console: isize,
+    input: Endpoint,
+    output: Endpoint,
+    attached: bool,
+}
+impl OwnedWindowsTerminal {
+    /// Accept only the existing reviewed synchronous workload pipe endpoints.
+    /// The host/peer end stays overlapped and serviced by the existing Owner.
+    pub fn new(
+        rows: u16,
+        columns: u16,
+        input: OwnedHandle,
+        output: OwnedHandle,
+    ) -> io::Result<Self> {
+        let mut terminal = Self {
+            console: 0,
+            input: Endpoint(Some(input)),
+            output: Endpoint(Some(output)),
+            attached: false,
+        };
+        let size = dimensions(rows, columns)?;
+        require_bounded_close_host()?;
+        if terminal.input.raw() == terminal.output.raw()
+            || validate_pipe_endpoint(terminal.input.0.as_ref().unwrap(), false).is_err()
+            || validate_pipe_endpoint(terminal.output.0.as_ref().unwrap(), true).is_err()
+        {
+            return Err(OwnedWindowsDiagnosticFailure::at(
+                OwnedWindowsDiagnosticStage::ConsoleEndpoints,
+            )
+            .error());
+        }
+        // These endpoints belong to ConPTY, never the child HANDLE_LIST.
+        for handle in [terminal.input.raw(), terminal.output.raw()] {
+            if unsafe { SetHandleInformation(handle, 1, 0) } == 0 {
+                return Err(OwnedWindowsDiagnosticFailure::at(
+                    OwnedWindowsDiagnosticStage::ConsoleEndpoints,
+                )
+                .error());
+            }
+        }
+        // flags0: no cursor query / asynchronous cursor responder is introduced.
+        let hr = unsafe {
+            CreatePseudoConsole(
+                size,
+                terminal.input.raw(),
+                terminal.output.raw(),
+                0,
+                &mut terminal.console,
+            )
+        };
+        if hr != 0 || terminal.console == 0 || terminal.console == -1 {
+            let mut facts =
+                OwnedWindowsDiagnosticFailure::at(OwnedWindowsDiagnosticStage::ConsoleCreate);
+            facts.hresult = Some(hr);
+            return Err(facts.error());
+        }
+        Ok(terminal)
+    }
+    pub(crate) fn raw(&self) -> isize {
+        self.console
+    }
+    pub(crate) fn attached(&mut self) -> io::Result<()> {
+        if self.attached || self.console == 0 {
+            return Err(OwnedWindowsDiagnosticFailure::at(
+                OwnedWindowsDiagnosticStage::ConsoleAttach,
+            )
+            .error());
+        }
+        // CreateProcess has succeeded, but Owner already retains the suspended
+        // child. Close our extra pipe references before querying/resuming it.
+        self.input.close();
+        self.output.close();
+        self.attached = true;
+        Ok(())
+    }
+    pub(crate) fn resize(&self, rows: u16, columns: u16) -> io::Result<()> {
+        if !self.attached || self.console == 0 {
+            return Err(OwnedWindowsDiagnosticFailure::at(
+                OwnedWindowsDiagnosticStage::ConsoleResize,
+            )
+            .error());
+        }
+        let hr = unsafe { ResizePseudoConsole(self.console, dimensions(rows, columns)?) };
+        if hr != 0 {
+            let mut facts =
+                OwnedWindowsDiagnosticFailure::at(OwnedWindowsDiagnosticStage::ConsoleResize);
+            facts.hresult = Some(hr);
+            return Err(facts.error());
+        }
+        Ok(())
+    }
+}
+impl Drop for OwnedWindowsTerminal {
+    fn drop(&mut self) {
+        // build>=26100 is checked before creating HPCON: Microsoft documents
+        // immediate ClosePseudoConsole there. Completion still requires Job0,
+        // the retained root, and output EOF; this call alone proves none of them.
+        if self.console != 0 && self.console != -1 {
+            let raw = std::mem::replace(&mut self.console, 0);
+            unsafe { ClosePseudoConsole(raw) };
+        }
+    }
+}
+pub enum OwnedWindowsDiagnosticIo {
+    Headless(OwnedWindowsStdio),
+    Terminal(OwnedWindowsTerminal),
+}
+pub(crate) struct DiagnosticLaunch<'a> {
+    pub(crate) case: OwnedWindowsDiagnosticCase,
+    pub(crate) terminal: Option<&'a OwnedWindowsTerminal>,
+    pub(crate) failure: Cell<OwnedWindowsDiagnosticFailure>,
+}
+impl<'a> DiagnosticLaunch<'a> {
+    pub(crate) fn new(
+        case: OwnedWindowsDiagnosticCase,
+        terminal: Option<&'a OwnedWindowsTerminal>,
+    ) -> io::Result<Self> {
+        if case.uses_conpty() != terminal.is_some() {
+            return Err(
+                OwnedWindowsDiagnosticFailure::at(OwnedWindowsDiagnosticStage::Input).error(),
+            );
+        }
+        Ok(Self {
+            case,
+            terminal,
+            failure: Cell::new(OwnedWindowsDiagnosticFailure::at(
+                OwnedWindowsDiagnosticStage::Input,
+            )),
+        })
+    }
+    pub(crate) fn stage(&self, stage: OwnedWindowsDiagnosticStage) {
+        self.failure.set(OwnedWindowsDiagnosticFailure::at(stage));
+    }
+    pub(crate) fn api_error(&self, error: &crate::learning_mode_windows::LearningModeError) {
+        let mut facts = self.failure.get();
+        match error {
+            crate::learning_mode_windows::LearningModeError::HResultCall { code, .. } => {
+                facts.hresult = Some(*code)
+            }
+            crate::learning_mode_windows::LearningModeError::ApiCall { code, .. } => {
+                facts.win32 = Some(*code)
+            }
+            _ => {}
+        }
+        self.failure.set(facts);
+    }
+    pub(crate) fn native_failure(&self, win32: u32, nt_status: u32) {
+        self.failure.set(OwnedWindowsDiagnosticFailure {
+            stage: OwnedWindowsDiagnosticStage::CreateProcess,
+            hresult: None,
+            win32: Some(win32),
+            nt_status: Some(nt_status),
+        });
+    }
+}
