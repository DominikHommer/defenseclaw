+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn console_controls_are_three_exact_nonfallback_cases() {
+        assert_eq!(
+            (
+                OwnedWindowsDiagnosticCase::OrdinaryConpty.uses_psec(),
+                OwnedWindowsDiagnosticCase::OrdinaryConpty.uses_conpty()
+            ),
+            (false, true)
+        );
+        assert_eq!(
+            (
+                OwnedWindowsDiagnosticCase::HeadlessPsec.uses_psec(),
+                OwnedWindowsDiagnosticCase::HeadlessPsec.uses_conpty()
+            ),
+            (true, false)
+        );
+        assert_eq!(
+            (
+                OwnedWindowsDiagnosticCase::ConptyPsec.uses_psec(),
+                OwnedWindowsDiagnosticCase::ConptyPsec.uses_conpty()
+            ),
+            (true, true)
+        );
+        assert!(DiagnosticLaunch::new(OwnedWindowsDiagnosticCase::ConptyPsec, None).is_err());
+        assert!(DiagnosticLaunch::new(OwnedWindowsDiagnosticCase::OrdinaryConpty, None).is_err());
+        assert!(DiagnosticLaunch::new(OwnedWindowsDiagnosticCase::HeadlessPsec, None).is_ok());
+    }
+    #[test]
+    fn console_dimensions_and_close_version_refuse_unbounded_shapes() {
+        for (rows, columns) in [(0, 80), (24, 0), (257, 80), (24, u16::MAX)] {
+            assert!(dimensions(rows, columns).is_err());
+        }
+        let size = dimensions(24, 80).unwrap();
+        assert_eq!((size.x, size.y), (80, 24));
+        assert!(!supported_close_version(10, 26099));
+        assert!(!supported_close_version(6, 99999));
+        assert!(supported_close_version(10, 26100));
+    }
+    #[test]
+    fn console_failure_has_closed_facts_and_no_native_error_text() {
+        let mut facts =
+            OwnedWindowsDiagnosticFailure::at(OwnedWindowsDiagnosticStage::CreateProcess);
+        facts.win32 = Some(6);
+        facts.nt_status = Some(0xc0000008);
+        let error = facts.error();
+        assert_eq!(
+            OwnedWindowsDiagnosticFailure::from_error(&error),
+            Some(facts)
+        );
+        assert_eq!(
+            error.to_string(),
+            "owned Windows console diagnostic refused"
+        );
+        assert!(
+            OwnedWindowsDiagnosticFailure::from_error(&io::Error::other("private path")).is_none()
+        );
+    }
+}
