+fn duplicate_retained_query_process_handle(
+    process: HANDLE,
+) -> std::io::Result<std::os::windows::io::OwnedHandle> {
+    use std::os::windows::io::FromRawHandle;
+    use windows::Win32::Foundation::{DUPLICATE_HANDLE_OPTIONS, DuplicateHandle};
+    use windows::Win32::System::Threading::{
+        GetCurrentProcess, PROCESS_QUERY_LIMITED_INFORMATION, PROCESS_SYNCHRONIZE,
+    };
+    let mut duplicate = HANDLE::default();
+    // SAFETY: the caller keeps the source process handle valid throughout
+    // this call. The new handle is noninheritable and has no mutation rights.
+    unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            process,
+            GetCurrentProcess(),
+            &mut duplicate,
+            PROCESS_QUERY_LIMITED_INFORMATION.0 | PROCESS_SYNCHRONIZE.0,
+            false,
+            DUPLICATE_HANDLE_OPTIONS(0),
+        )
+    }
+    .map_err(|error| {
+        // Only FACILITY_WIN32 HRESULTs embed a Win32 error in the low word.
+        // Preserve other facilities as HRESULT diagnostics instead of
+        // misreporting their low word as an unrelated OS error.
+        let hr = error.code().0 as u32;
+        if (hr & 0xFFFF_0000) == 0x8007_0000 {
+            std::io::Error::from_raw_os_error((hr & 0xFFFF) as i32)
+        } else {
+            std::io::Error::other(error.to_string())
+        }
+    })?;
+    // SAFETY: DuplicateHandle created a distinct owned kernel handle.
+    Ok(unsafe { std::os::windows::io::OwnedHandle::from_raw_handle(duplicate.0) })
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum OwnedPsecStart {
+    Running,
+    Suspended,
+    Refused,
+}
+impl OwnedPsecStart {
+    fn begin(&mut self, stopped: bool) -> std::io::Result<()> {
+        if *self != Self::Suspended {
+            return Err(std::io::Error::other("owned PSEC resume is not pending"));
+        }
+        // No callback, query, panic or retry can turn a failed attempt into a
+        // later resume. The caller keeps the same exclusive cleanup owner.
+        *self = Self::Refused;
+        if stopped {
+            return Err(std::io::Error::other("owned PSEC resume was cancelled"));
+        }
+        Ok(())
+    }
+}
+
+struct OwnedAdmissionSeal<S: FnOnce()> {
+    seal: Option<S>,
+}
+impl<S: FnOnce()> Drop for OwnedAdmissionSeal<S> {
+    fn drop(&mut self) {
+        if let Some(seal) = self.seal.take() {
+            seal();
+        }
+    }
+}
+
+// Install rollback before checking whether this owner can begin. A host
+// endpoint may already be bound even when cancellation or a duplicate call
+// refuses before any admission callback. No early return may bypass sealing.
+fn begin_owned_admission<S: FnOnce()>(
+    start: &mut OwnedPsecStart,
+    stopped: bool,
+    seal: S,
+) -> std::io::Result<OwnedAdmissionSeal<S>> {
+    let rollback = OwnedAdmissionSeal { seal: Some(seal) };
+    start.begin(stopped)?;
+    Ok(rollback)
+}
+
+fn owned_admission_before_resume<Q>(
+    mut live: impl FnMut() -> std::io::Result<()>,
+    mut custody: impl FnMut() -> std::io::Result<()>,
+    query: impl FnOnce() -> std::io::Result<Q>,
+    admit: impl FnOnce(&Q) -> std::io::Result<()>,
+    resume: impl FnOnce() -> std::io::Result<()>,
+    seal: impl FnOnce(),
+) -> std::io::Result<()> {
+    let mut rollback = OwnedAdmissionSeal { seal: Some(seal) };
+    live()?;
+    custody()?;
+    let query = query()?;
+    admit(&query)?;
+    live()?;
+    custody()?;
+    resume()?;
+    let _ = rollback.seal.take();
+    Ok(())
+}
