+}
+
+#[cfg(test)]
+mod native_access_tests {
+    use super::*;
+    #[test]
+    fn native_current_image_read_handle_cannot_be_promoted_to_execute_or_write() {
+        let own = std::env::current_exe().unwrap();
+        let file = File::open(own).unwrap();
+        assert!(access(&file, false, false).is_ok());
