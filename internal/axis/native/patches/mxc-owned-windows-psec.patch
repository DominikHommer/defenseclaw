+impl OwnedPsecProcess {
+    /// Duplicate the retained native child handle for identity queries and waiting.
+    ///
+    /// The returned handle is non-inheritable, independently owned, and limited
+    /// to `PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE`. This does not reopen
+    /// a numeric PID or transfer this owner's stop, Job wait, or cleanup duties.
+    pub fn duplicate_query_process_handle(
+        &self,
+    ) -> std::io::Result<std::os::windows::io::OwnedHandle> {
+        duplicate_retained_query_process_handle(self.child.process.get())
+    }
+
+    /// Bind the exact suspended child to its trusted host session, then resume.
+    ///
+    /// `live` must check the existing owner lifetime/cancellation; `admit` must
+    /// synchronously complete endpoint binding using this borrowed restricted
+    /// query handle and the caller's trusted session identity. Neither callback
+    /// may select authority from a PID, guest profile or client-supplied label.
+    /// Both callbacks must obey the existing owner/outer deadline; the SDK does
+    /// not detach a worker or interrupt a blocking callback. The query duplicate
+    /// stays held through Resume and must not be closed by the borrowed caller.
+    /// `seal` must synchronously close host endpoint admission in memory without
+    /// blocking, panicking, filesystem I/O or waiting for native cleanup. Error
+    /// and unwind paths call it before Stop; durable revocation/drain is later.
+    /// This includes cancellation, repeated calls, and nonpending-state refusal
+    /// before either callback runs, even when the host prebound its endpoint.
+    ///
+    /// Any refusal consumes the one attempt and requests Stop. On error this
+    /// same value retains all cleanup custody: revoke endpoint admission, then
+    /// Stop/try_wait to native completion before releasing dependent assets.
+    /// Omitting this call never resumes a spawn_suspended child. Panic leaves
+    /// it Refused and suspended, with this same owner still requiring cleanup.
+    pub fn admit_and_resume(
+        &mut self,
+        live: impl FnMut() -> std::io::Result<()>,
+        admit: impl FnOnce(&std::os::windows::io::OwnedHandle) -> std::io::Result<()>,
+        seal: impl FnOnce(),
+    ) -> std::io::Result<()> {
+        let attempt = begin_owned_admission(
+            &mut self.start,
+            self.stop_requested || self.code.is_some(),
+            seal,
+        );
+        let result = match attempt {
+            Ok(mut rollback) => {
+                let result = owned_admission_before_resume(
+                    live,
+                    || {
+                        let custody = self.resume_custody.as_ref().ok_or_else(|| {
+                            std::io::Error::other("owned PSEC suspended image custody absent")
+                        })?;
+                        if unsafe { WaitForSingleObject(self.child.process.get(), 0) }
+                            != WAIT_TIMEOUT
+                            || self.active_processes()? != 1
+                            || literal_image_mapping_status(self.child.process.get(), custody) != 0
+                        {
+                            return Err(std::io::Error::other(
+                                "owned PSEC suspended custody differs",
+                            ));
+                        }
+                        Ok(())
+                    },
+                    || duplicate_retained_query_process_handle(self.child.process.get()),
+                    admit,
+                    || {
+                        // A freshly created private primary thread has suspend count1.
+                        // Any other result is terminal refusal, never a resume retry.
+                        let previous = unsafe { ResumeThread(self.child.thread.get()) };
+                        if previous == u32::MAX {
+                            return Err(std::io::Error::last_os_error());
+                        }
+                        if previous != 1 {
+                            return Err(std::io::Error::other("owned PSEC suspend count differs"));
+                        }
+                        Ok(())
+                    },
+                    || {
+                        if let Some(seal) = rollback.seal.take() {
+                            seal();
+                        }
+                    },
+                );
+                if result.is_ok() {
+                    let _ = rollback.seal.take();
+                }
+                result
+            }
+            Err(error) => Err(error),
+        };
+        match result {
+            Ok(()) => {
+                self.start = OwnedPsecStart::Running;
+                Ok(())
+            }
+            Err(error) => {
+                if self.stop().is_err() {
+                    return Err(std::io::Error::other(
+                        "owned PSEC admission/resume refused and Stop incomplete",
+                    ));
+                }
+                Err(error)
+            }
+        }
+    }
+
+    fn active_processes(&self) -> std::io::Result<u32> {
+        let job = self
+            .child
+            .job
+            .as_ref()
+            .ok_or_else(|| std::io::Error::other("owned PSEC Job absent"))?;
+        let mut accounting: OwnedJobAccounting = unsafe { std::mem::zeroed() };
+        let mut used = 0;
+        if unsafe {
+            owned_query_job(
+                HANDLE(job.handle_value() as *mut c_void),
+                1,
+                (&mut accounting as *mut OwnedJobAccounting).cast(),
+                std::mem::size_of::<OwnedJobAccounting>() as u32,
+                &mut used,
+            )
+        } == 0
+            || used != std::mem::size_of::<OwnedJobAccounting>() as u32
+        {
+            return Err(std::io::Error::other("owned PSEC Job accounting refused"));
+        }
+        Ok(accounting.active)
+    }
+    fn empty(&self) -> std::io::Result<bool> {
+        self.active_processes().map(|active| active == 0)
+    }
+    pub fn stop(&mut self) -> std::io::Result<()> {
+        self.stop_requested = true;
+        let job = self
+            .child
+            .job
+            .as_ref()
+            .ok_or_else(|| std::io::Error::other("owned PSEC Job absent"))?;
+        let job_result = job.terminate(u32::MAX);
+        let root = unsafe { WaitForSingleObject(self.child.process.get(), 0) };
+        let root_result = if root == WAIT_TIMEOUT {
+            unsafe { TerminateProcess(self.child.process.get(), u32::MAX) }
+                .map_err(|_| std::io::Error::other("owned PSEC root stop refused"))
+        } else if root == WAIT_OBJECT_0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::other("owned PSEC root wait refused"))
+        };
+        if job_result.is_err() || root_result.is_err() {
+            return Err(std::io::Error::other("owned PSEC stop incomplete"));
+        }
+        Ok(())
+    }
+    pub fn try_wait(&mut self) -> std::io::Result<Option<i32>> {
+        let wait = unsafe { WaitForSingleObject(self.child.process.get(), 0) };
+        if wait == WAIT_TIMEOUT {
+            return Ok(None);
+        }
+        if wait != WAIT_OBJECT_0 {
+            return Err(std::io::Error::other("owned PSEC root wait refused"));
+        }
+        if self.code.is_none() {
+            let mut code = 0;
+            unsafe { GetExitCodeProcess(self.child.process.get(), &mut code) }
+                .map_err(|_| std::io::Error::other("owned PSEC root result refused"))?;
+            self.code = Some(code as i32);
+        }
+        // Root exit alone is insufficient: stop remaining descendants, then
+        // observe Job active0 with a nonblocking accounting query before exit.
+        if !self.stop_requested {
+            self.stop()?;
+        }
+        if !self.empty()? {
+            return Ok(None);
+        }
+        self.child.security_environment.take();
+        Ok(self.code)
+    }
+}
+impl Drop for OwnedPsecProcess {
+    fn drop(&mut self) {
+        // No wait, thread join, or new launch is hidden here. The exact owned
+        // Job's kill-on-close plus the independent Go outer Job contain error
+        // exits. Only try_wait above can establish normal teardown completion.
+        let _ = self.stop();
+    }
+}
+impl BaseContainerRunner {
+    pub(crate) fn spawn_owned_psec(
+        &mut self,
+        request: ExecutionRequest,
+        argv: crate::mxc_common::literal_argv::LiteralArgv,
+        custody: LocalExecutableCustody,
+        files: Vec<std::fs::File>,
+        stdio: crate::owned_windows_psec::OwnedWindowsStdio,
+    ) -> Result<OwnedPsecProcess, ScriptResponse> {
+        self.spawn_owned_psec_with_mode(request, argv, custody, files, stdio, false)
+    }
+
+    pub(crate) fn spawn_owned_psec_suspended(
+        &mut self,
+        request: ExecutionRequest,
+        argv: crate::mxc_common::literal_argv::LiteralArgv,
+        custody: LocalExecutableCustody,
+        files: Vec<std::fs::File>,
+        stdio: crate::owned_windows_psec::OwnedWindowsStdio,
+    ) -> Result<OwnedPsecProcess, ScriptResponse> {
+        self.spawn_owned_psec_with_mode(request, argv, custody, files, stdio, true)
+    }
+
+    fn spawn_owned_psec_with_mode(
+        &mut self,
+        request: ExecutionRequest,
+        argv: crate::mxc_common::literal_argv::LiteralArgv,
+        custody: LocalExecutableCustody,
+        files: Vec<std::fs::File>,
+        stdio: crate::owned_windows_psec::OwnedWindowsStdio,
+        defer_owned_resume: bool,
+    ) -> Result<OwnedPsecProcess, ScriptResponse> {
+        crate::mxc_common::validator::validate_argv_common(&request, &argv)?;
+        self.validate(&request)?;
+        windows_literal_argv_buffers(&argv)?;
+        crate::owned_windows_psec::validate_stdio(&stdio)
+            .map_err(|_| ScriptResponse::rejected("owned synchronous workload stdio refused"))?;
+        let mut logger = Logger::new(crate::mxc_common::logger::Mode::Buffer);
+        let child = self.spawn_base(
+            &request,
+            &mut logger,
+            false,
+            Some(&argv),
+            Some(&custody),
+            Some(&stdio),
+            defer_owned_resume,
+        )?;
+        Ok(OwnedPsecProcess {
+            child,
+            start: if defer_owned_resume {
+                OwnedPsecStart::Suspended
+            } else {
+                OwnedPsecStart::Running
+            },
+            resume_custody: if defer_owned_resume {
+                Some(custody)
+            } else {
+                None
+            },
+            _files: files,
+            stop_requested: false,
+            code: None,
+        })
+    }
+}
