+#[cfg(test)]
+mod owned_psec_resume_tests {
+    use super::*;
+    use std::cell::RefCell;
+
+    #[test]
+    fn owned_resume_orders_live_identity_admission_and_fresh_custody_before_resume() {
+        let calls = RefCell::new(Vec::new());
+        owned_admission_before_resume(
+            || {
+                calls.borrow_mut().push("live");
+                Ok(())
+            },
+            || {
+                calls.borrow_mut().push("custody");
+                Ok(())
+            },
+            || {
+                calls.borrow_mut().push("query");
+                Ok(73)
+            },
+            |query| {
+                assert_eq!(*query, 73);
+                calls.borrow_mut().push("admit");
+                Ok(())
+            },
+            || {
+                calls.borrow_mut().push("resume");
+                Ok(())
+            },
+            || {
+                calls.borrow_mut().push("seal");
+            },
+        )
+        .unwrap();
+        assert_eq!(
+            *calls.borrow(),
+            [
+                "live", "custody", "query", "admit", "live", "custody", "resume"
+            ]
+        );
+    }
+
+    #[test]
+    fn owned_resume_refuses_each_failed_gate_without_later_admission_or_resume() {
+        for failure in 1..=7 {
+            let calls = RefCell::new(Vec::new());
+            let step = |name| {
+                let mut calls = calls.borrow_mut();
+                calls.push(name);
+                if calls.len() == failure {
+                    Err(std::io::Error::other("fixed synthetic refusal"))
+                } else {
+                    Ok(())
+                }
+            };
+            let result = owned_admission_before_resume(
+                || step("live"),
+                || step("custody"),
+                || step("query").map(|()| 73),
+                |query| {
+                    assert_eq!(*query, 73);
+                    step("admit")
+                },
+                || step("resume"),
+                || {
+                    calls.borrow_mut().push("seal");
+                },
+            );
+            assert!(result.is_err());
+            // This is the caller's native Stop boundary: rollback has already
+            // sealed even if admission succeeded and a later gate failed.
+            assert_eq!(calls.borrow().last(), Some(&"seal"));
+            calls.borrow_mut().push("stop");
+            assert_eq!(calls.borrow().len(), failure + 2);
+            assert_eq!(&calls.borrow()[failure..], &["seal", "stop"]);
+            assert_eq!(
+                calls
+                    .borrow()
+                    .iter()
+                    .filter(|name| **name == "resume")
+                    .count(),
+                usize::from(failure == 7)
+            );
+            if failure >= 5 {
+                assert_eq!(
+                    calls
+                        .borrow()
+                        .iter()
+                        .filter(|name| **name == "admit")
+                        .count(),
+                    1
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn owned_resume_attempt_is_one_shot_for_cancel_refusal_and_panic() {
+        for (mut start, stopped) in [
+            (OwnedPsecStart::Suspended, true),
+            (OwnedPsecStart::Refused, false),
+            (OwnedPsecStart::Running, false),
+        ] {
+            let calls = RefCell::new(Vec::new());
+            let result = begin_owned_admission(&mut start, stopped, || {
+                calls.borrow_mut().push("seal");
+            });
+            assert!(result.is_err());
+            // The public method's common error branch invokes native Stop only
+            // after begin has returned and its refusal guard has sealed.
+            assert_eq!(*calls.borrow(), ["seal"]);
+            calls.borrow_mut().push("stop");
+            assert_eq!(*calls.borrow(), ["seal", "stop"]);
+            drop(result);
+            assert_eq!(*calls.borrow(), ["seal", "stop"]);
+        }
+
+        let mut omitted = OwnedPsecStart::Suspended;
+        assert_eq!(omitted, OwnedPsecStart::Suspended);
+        assert!(omitted.begin(true).is_err());
+        assert_eq!(omitted, OwnedPsecStart::Refused);
+        assert!(omitted.begin(false).is_err());
+
+        let mut attempted = OwnedPsecStart::Suspended;
+        assert!(attempted.begin(false).is_ok());
+        assert_eq!(attempted, OwnedPsecStart::Refused);
+        let sealed = std::sync::atomic::AtomicBool::new(false);
+        let result = std::panic::catch_unwind(|| {
+            owned_admission_before_resume(
+                || Ok(()),
+                || Ok(()),
+                || Ok(73),
+                |_| -> std::io::Result<()> { panic!("fixed admission panic") },
+                || -> std::io::Result<()> { panic!("resume must not be called") },
+                || {
+                    sealed.store(true, std::sync::atomic::Ordering::SeqCst);
+                },
+            )
+        });
+        assert!(result.is_err());
+        assert!(sealed.load(std::sync::atomic::Ordering::SeqCst));
+        assert!(attempted.begin(false).is_err());
+        let mut running = OwnedPsecStart::Running;
+        assert!(running.begin(false).is_err());
+        assert_eq!(running, OwnedPsecStart::Running);
+    }
+}
