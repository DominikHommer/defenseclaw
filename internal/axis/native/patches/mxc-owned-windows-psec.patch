+// Copyright 2026 Cisco Systems, Inc. and its affiliates
+// SPDX-License-Identifier: MIT
+
+//! Contributor-only owned native PSEC inputs. No fallback, resolver or shell.
+//! The host must retain the immutable private image copy's section/view while
+//! this value/process exists. A read-only original is not an immutable copy.
+//! The host must also retain its no-delete-share ancestor leases above CWD
+//! and around the sealed image. A File alone does not freeze its DOS spelling.
+use crate::mxc_common::literal_argv::LiteralArgv;
+use crate::mxc_common::models::ScriptResponse;
+use crate::policy::{ContainerRequest, PreparedContainerRequest};
+use crate::process_container_common::base_container_runner::{
+    BaseContainerRunner, LocalExecutableCustody, OwnedPsecProcess,
+};
+use std::ffi::{OsString, c_void};
+use std::fs::File;
+use std::io;
+use std::mem::size_of;
+use std::os::windows::io::{AsRawHandle, OwnedHandle};
+use windows::Win32::Foundation::HANDLE;
+
+fn refused() -> io::Error {
+    io::Error::other("owned Windows PSEC admission refused")
+}
+#[repr(C, align(8))]
+struct Basic {
+    attributes: u32,
+    access: u32,
+    count: u32,
+    pointers: u32,
+    reserved: [u32; 10],
+}
+const _: () = assert!(size_of::<Basic>() == 56);
+#[repr(C)]
+struct Identity {
+    volume: u64,
+    file: [u8; 16],
+}
+#[repr(C)]
+struct Info {
+    attributes: u32,
+    times: [u32; 6],
+    volume: u32,
+    high: u32,
+    low: u32,
+    links: u32,
+    id_high: u32,
+    id_low: u32,
+}
+#[repr(C)]
+struct Name {
+    length: u16,
+    maximum: u16,
+    buffer: *mut u16,
+}
+#[repr(C)]
+struct Attributes {
+    size: u32,
+    root: HANDLE,
+    name: *mut Name,
+    attributes: u32,
+    security: *mut c_void,
+    qos: *mut c_void,
+}
+#[repr(C)]
+struct Status {
+    status: usize,
+    information: usize,
+}
+const _: () = assert!(size_of::<Identity>() == 24);
+const _: () = assert!(size_of::<Info>() == 52);
+const _: () = assert!(size_of::<Name>() == 16);
+const _: () = assert!(size_of::<Attributes>() == 48);
+const _: () = assert!(size_of::<Status>() == 16);
+#[link(name = "ntdll")]
+unsafe extern "system" {
+    fn NtQueryObject(
+        handle: HANDLE,
+        class: u32,
+        output: *mut c_void,
+        size: u32,
+        used: *mut u32,
+    ) -> i32;
+    fn NtQueryInformationFile(
+        handle: HANDLE,
+        status: *mut Status,
+        output: *mut c_void,
+        size: u32,
+        class: u32,
+    ) -> i32;
+    fn NtOpenFile(
+        output: *mut HANDLE,
+        access: u32,
+        attributes: *mut Attributes,
+        status: *mut Status,
+        share: u32,
+        options: u32,
+    ) -> i32;
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn GetFileType(handle: HANDLE) -> u32;
+    fn GetHandleInformation(handle: HANDLE, flags: *mut u32) -> i32;
+    fn GetFileInformationByHandle(handle: HANDLE, info: *mut Info) -> i32;
+    fn GetFileInformationByHandleEx(
+        handle: HANDLE,
+        class: u32,
+        info: *mut c_void,
+        size: u32,
+    ) -> i32;
+    fn GetFinalPathNameByHandleW(handle: HANDLE, buffer: *mut u16, size: u32, flags: u32) -> u32;
+}
