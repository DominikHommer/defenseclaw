+    #[test]
+    fn native_relative_grant_pin_requires_the_exact_held_file_object() {
+        use std::os::windows::fs::OpenOptionsExt;
+        let directory = tempfile::tempdir().unwrap();
+        let root_path = directory.path().join("fixed-root");
+        let renamed = directory.path().join("fixed-root-renamed");
+        std::fs::create_dir(&root_path).unwrap();
+        std::fs::create_dir(root_path.join("fixed-subdir")).unwrap();
+        std::fs::write(
+            root_path.join("fixed-subdir/fixed.txt"),
+            b"fixed public bytes",
+        )
+        .unwrap();
+        std::fs::write(root_path.join("fixed-other.txt"), b"fixed public bytes").unwrap();
+        let root = std::fs::OpenOptions::new()
+            .read(true)
+            .share_mode(7)
+            .custom_flags(0x02200000)
+            .open(&root_path)
+            .unwrap();
+        // Input share-delete alone does not prevent renaming. The self-open
+        // must add its own same-object, no-delete-share directory lease.
+        std::fs::rename(&root_path, &renamed).unwrap();
+        std::fs::rename(&renamed, &root_path).unwrap();
+        let root_pin = relative_pin(&root, &root, "", true).unwrap();
+        assert_eq!(root_pin.len(), 1);
+        assert!(std::fs::rename(&root_path, &renamed).is_err());
+        drop(root_pin);
+        std::fs::rename(&root_path, &renamed).unwrap();
+        std::fs::rename(&renamed, &root_path).unwrap();
+        let target = File::open(root_path.join("fixed-subdir/fixed.txt")).unwrap();
+        let other = File::open(root_path.join("fixed-other.txt")).unwrap();
+        let pins = relative_pin(&root, &target, r"fixed-subdir\fixed.txt", false).unwrap();
+        assert_eq!(pins.len(), 2);
+        assert!(relative_pin(&root, &other, r"fixed-subdir\fixed.txt", false).is_err());
+        drop(pins);
+        drop(target);
+        drop(other);
+        drop(root);
+        directory.close().unwrap();
+    }
+}
