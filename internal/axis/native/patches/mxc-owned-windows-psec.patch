+pub(crate) fn actual_path(file: &File) -> io::Result<String> {
+    let mut value = vec![0u16; 32768];
+    let used = unsafe {
+        GetFinalPathNameByHandleW(HANDLE(file.as_raw_handle()), value.as_mut_ptr(), 32768, 0)
+    } as usize;
+    if used == 0 || used >= value.len() {
+        return Err(refused());
+    }
+    let value = String::from_utf16(&value[..used]).map_err(|_| refused())?;
+    let value = value.strip_prefix(r"\\?\").unwrap_or(&value).to_owned();
+    super::process_container_common::base_container_runner::local_executable_parts(
+        std::ffi::OsStr::new(&value),
+    )
+    .map_err(|_| refused())?;
+    Ok(value)
+}
+fn identity(file: &File, directory: bool) -> io::Result<Identity> {
+    let mut info: Info = unsafe { std::mem::zeroed() };
+    let mut identity = Identity {
+        volume: 0,
+        file: [0; 16],
+    };
+    if unsafe { GetFileInformationByHandle(HANDLE(file.as_raw_handle()), &mut info) } == 0
+        || info.attributes & 0x400 != 0
+        || (info.attributes & 0x10 != 0) != directory
+        || (!directory && info.links != 1)
+        || unsafe {
+            GetFileInformationByHandleEx(
+                HANDLE(file.as_raw_handle()),
+                18,
+                (&mut identity as *mut Identity).cast(),
+                24,
+            )
+        } == 0
+    {
+        return Err(refused());
+    }
+    Ok(identity)
+}
+fn access(file: &File, write: bool, image: bool) -> io::Result<()> {
+    let mut value: Basic = unsafe { std::mem::zeroed() };
+    let mut used = 0;
+    if unsafe {
+        NtQueryObject(
+            HANDLE(file.as_raw_handle()),
+            0,
+            (&mut value as *mut Basic).cast(),
+            size_of::<Basic>() as u32,
+            &mut used,
+        )
+    } != 0
+        || used != size_of::<Basic>() as u32
+    {
+        return Err(refused());
+    }
+    if !access_allowed(value.access, write, image) {
+        return Err(refused());
+    }
+    Ok(())
+}
+fn access_allowed(granted: u32, write: bool, image: bool) -> bool {
+    let required = 0x120089 | if write { 0x116 } else { 0 } | if image { 0x20 } else { 0 };
+    // No DELETE/DELETE_CHILD, security-descriptor writes, SACL access or
+    // unrecognized privilege-bearing bits. FILE_EXECUTE/TRAVERSE is the only
+    // optional readonly right beyond the exact generic-read/write role mask.
+    let allowed = required | 0x20;
+    granted & required == required && granted & !allowed == 0
+}
+
+fn relative_pin(
+    root: &File,
+    source: &File,
+    relative: &str,
+    directory: bool,
+) -> io::Result<Vec<File>> {
+    use std::os::windows::io::FromRawHandle;
+    let self_root = relative.is_empty();
+    if self_root && !directory {
+        return Err(refused());
+    }
+    let parts: Vec<_> = relative.split('\\').collect();
+    if parts.is_empty() || parts.len() > 256 {
+        return Err(refused());
+    }
+    let mut result: Vec<File> = Vec::with_capacity(parts.len());
+    for (index, part) in parts.iter().enumerate() {
+        if (!self_root && part.is_empty())
+            || *part == "."
+            || *part == ".."
+            || part.contains(['/', ':', '\0'])
+        {
+            return Err(refused());
+        }
+        let mut units: Vec<_> = part.encode_utf16().collect();
+        if (!self_root && units.is_empty()) || units.len() > 255 {
+            return Err(refused());
+        }
+        let mut name = Name {
+            length: (units.len() * 2) as u16,
+            maximum: (units.len() * 2) as u16,
+            // NT's empty ObjectName addresses the held root itself. A literal
+            // dot is not the same native operation and is never substituted.
+            buffer: if units.is_empty() {
+                std::ptr::null_mut()
+            } else {
+                units.as_mut_ptr()
+            },
+        };
+        let parent = result.last().unwrap_or(root);
+        let mut attributes = Attributes {
+            size: size_of::<Attributes>() as u32,
+            root: HANDLE(parent.as_raw_handle()),
+            name: &mut name,
+            attributes: 0x1000,
+            security: std::ptr::null_mut(),
+            qos: std::ptr::null_mut(),
+        };
+        let mut status = Status {
+            status: 0,
+            information: 0,
+        };
+        let mut handle = HANDLE::default();
+        let dir = index + 1 != parts.len() || directory;
+        let nt = unsafe {
+            NtOpenFile(
+                &mut handle,
+                0x120089,
+                &mut attributes,
+                &mut status,
+                3,
+                0x200000 | 0x20 | if dir { 1 } else { 0x40 },
+            )
+        };
+        if handle.0.is_null() || handle.0 as isize == -1 {
+            return Err(refused());
+        }
+        let file = unsafe { File::from_raw_handle(handle.0) };
+        if nt as u32 == 0x103 {
+            unsafe { ExitProcess(70) }
+        }
+        if nt != 0 {
+            return Err(refused());
+        }
+        identity(&file, dir)?;
+        result.push(file);
+    }
+    let a = identity(result.last().ok_or_else(refused)?, directory)?;
+    let b = identity(source, directory)?;
+    if a.volume != b.volume || a.file != b.file {
+        return Err(refused());
+    }
+    Ok(result)
+}
+
+// Root privacy is an explicit current-user + SYSTEM protected DACL. Paths are
+// used only to correlate held objects; no string opens an arbitrary host grant.
+include!("owned_windows_root_security.rs");
+
+fn synchronous_stdio_mode(mode: u32, access: u32, writing: bool) -> bool {
+    matches!(mode & 0x30, 0x10 | 0x20)
+        && access & (0x100000 | if writing { 2 } else { 1 })
+            == (0x100000 | if writing { 2 } else { 1 })
+}
+pub(crate) fn validate_stdio(stdio: &OwnedWindowsStdio) -> io::Result<()> {
+    for (handle, writing) in [
+        (&stdio.stdin, false),
+        (&stdio.stdout, true),
+        (&stdio.stderr, true),
+    ] {
+        let mut flags = 0;
+        if unsafe { GetFileType(HANDLE(handle.as_raw_handle())) } != 3
+            || unsafe { GetHandleInformation(HANDLE(handle.as_raw_handle()), &mut flags) } == 0
+            || flags & 1 == 0
+        {
+            return Err(refused());
+        }
+        let mut mode = 0u32;
+        let mut status = Status {
+            status: 0,
+            information: 0,
+        };
+        let result = unsafe {
+            NtQueryInformationFile(
+                HANDLE(handle.as_raw_handle()),
+                &mut status,
+                (&mut mode as *mut u32).cast(),
+                4,
+                16,
+            )
+        };
+        if result as u32 == 0x103 {
+            unsafe { ExitProcess(70) }
+        }
+        let mut basic: Basic = unsafe { std::mem::zeroed() };
+        let mut used = 0;
+        if result != 0
+            || status.information != 4
+            || unsafe {
+                NtQueryObject(
+                    HANDLE(handle.as_raw_handle()),
+                    0,
+                    (&mut basic as *mut Basic).cast(),
+                    56,
+                    &mut used,
+                )
+            } != 0
+            || used != 56
+            || !synchronous_stdio_mode(mode, basic.access, writing)
+        {
+            return Err(refused());
+        }
+    }
+    Ok(())
+}
+/// Closed diagnostic correlation only; it never selects a grant or fallback.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OwnedWindowsPreparationStage {
+    InputShape,
+    PayloadAccess,
+    PayloadIdentity,
+    CwdAccess,
+    CwdIdentity,
+    CwdPrivacy,
+    CwdPath,
+    RootPin,
+    GrantAccess,
+    GrantIdentity,
+    GrantPath,
+    GrantPin,
+    PayloadPath,
+    ArgvPolicy,
+    PolicyFloor,
+    PayloadCustody,
+}
+
+#[derive(Debug)]
+struct OwnedWindowsPreparationError {
+    stage: OwnedWindowsPreparationStage,
+    cause: io::Error,
+}
+impl std::fmt::Display for OwnedWindowsPreparationError {
+    fn fmt(&self, output: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        output.write_str("owned Windows PSEC preparation refused")
+    }
+}
+impl std::error::Error for OwnedWindowsPreparationError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.cause)
+    }
+}
+fn preparation_error(stage: OwnedWindowsPreparationStage, cause: io::Error) -> io::Error {
+    io::Error::new(cause.kind(), OwnedWindowsPreparationError { stage, cause })
+}
+
+pub struct PreparedOwnedWindowsPsec {
+    request: PreparedContainerRequest,
+    argv: LiteralArgv,
+    custody: LocalExecutableCustody,
+    files: Vec<File>,
+}
+pub struct OwnedWindowsStdio {
+    pub(crate) stdin: OwnedHandle,
+    pub(crate) stdout: OwnedHandle,
+    pub(crate) stderr: OwnedHandle,
+}
+impl OwnedWindowsStdio {
+    pub fn new(stdin: OwnedHandle, stdout: OwnedHandle, stderr: OwnedHandle) -> io::Result<Self> {
+        let owned = Self {
+            stdin,
+            stdout,
+            stderr,
+        };
+        let values = [
+            owned.stdin.as_raw_handle(),
+            owned.stdout.as_raw_handle(),
+            owned.stderr.as_raw_handle(),
+        ];
+        if values
+            .iter()
+            .enumerate()
+            .any(|(index, value)| value.is_null() || values[..index].contains(value))
+        {
+            return Err(refused());
+        }
+        validate_stdio(&owned)?;
+        Ok(owned)
+    }
+}
+impl PreparedOwnedWindowsPsec {
+    /// The caller retains the immutable image view and the no-delete-share
+    /// parent/ancestor leases for CWD and the sealed payload until completion.
+    /// This constructor pins CWD itself and supported descendants, not parents
+    /// above the supplied root or ancestors of the separately sealed image.
+    pub fn new(
+        request: ContainerRequest,
+        values: Vec<OsString>,
+        payload: File,
+        cwd: File,
+        readonly: Vec<File>,
+        readwrite: Vec<File>,
+    ) -> io::Result<Self> {
+        let mut stage = OwnedWindowsPreparationStage::InputShape;
+        let result = (|| {
+            let fs = request.filesystem.as_ref().ok_or_else(refused)?;
+            if fs.readonly_paths.len() != readonly.len()
+                || fs.readwrite_paths.len() != readwrite.len()
+                || !fs.denied_paths.is_empty()
+            {
+                return Err(refused());
+            }
+            stage = OwnedWindowsPreparationStage::PayloadAccess;
+            access(&payload, false, true)?;
+            stage = OwnedWindowsPreparationStage::PayloadIdentity;
+            identity(&payload, false)?;
+            stage = OwnedWindowsPreparationStage::CwdAccess;
+            access(&cwd, false, false)?;
+            stage = OwnedWindowsPreparationStage::CwdIdentity;
+            identity(&cwd, true)?;
+            stage = OwnedWindowsPreparationStage::CwdPrivacy;
+            private_root(&cwd)?;
+            stage = OwnedWindowsPreparationStage::CwdPath;
+            let root = actual_path(&cwd)?;
+            if request.working_directory.as_deref() != Some(root.as_str()) {
+                return Err(refused());
+            }
+            stage = OwnedWindowsPreparationStage::RootPin;
+            let mut pins = relative_pin(&cwd, &cwd, "", true)?;
+            for (paths, objects, write) in [
+                (&fs.readonly_paths, &readonly, false),
+                (&fs.readwrite_paths, &readwrite, true),
+            ] {
+                for (path, object) in paths.iter().zip(objects) {
+                    stage = OwnedWindowsPreparationStage::GrantIdentity;
+                    let directory = object.metadata().map_err(|_| refused())?.is_dir();
+                    stage = OwnedWindowsPreparationStage::GrantAccess;
+                    access(object, write, false)?;
+                    stage = OwnedWindowsPreparationStage::GrantIdentity;
+                    identity(object, directory)?;
+                    stage = OwnedWindowsPreparationStage::GrantPath;
+                    if actual_path(object)? != *path {
+                        return Err(refused());
+                    }
+                    stage = OwnedWindowsPreparationStage::GrantPin;
+                    let relative = if *path == root {
+                        ""
+                    } else {
+                        path.strip_prefix(&(root.clone() + "\\"))
+                            .ok_or_else(refused)?
+                    };
+                    pins.extend(relative_pin(&cwd, object, relative, directory)?);
+                }
+            }
+            stage = OwnedWindowsPreparationStage::PayloadPath;
+            let payload_path = actual_path(&payload)?;
+            let mut request = request;
+            let fs = request.filesystem.as_mut().ok_or_else(refused)?;
+            // The exact frozen executable is the only extra read object; it never
+            // grants its parent directory or original caller image pathname.
+            if !fs.readonly_paths.contains(&payload_path) {
+                fs.readonly_paths.push(payload_path);
+            }
+            stage = OwnedWindowsPreparationStage::ArgvPolicy;
+            let (prepared, argv) = crate::v1::prepare_windows_psec_argv(
+                &request,
+                values,
+                Some(crate::options::TelemetryConfig {
+                    enabled: Some(false),
+                }),
+            )
+            .map_err(|_| refused())?;
+            stage = OwnedWindowsPreparationStage::PolicyFloor;
+            if prepared.inner.policy.capture_denials.is_some()
+                || prepared.inner.policy.network_proxy.address.is_some()
+                || prepared.inner.lifecycle.preserve_policy
+            {
+                return Err(refused());
+            }
+            stage = OwnedWindowsPreparationStage::PayloadCustody;
+            let custody =
+                LocalExecutableCustody::from_owned(payload.try_clone().map_err(|_| refused())?)
+                    .map_err(|_| refused())?;
+            let mut files = vec![payload, cwd];
+            files.extend(readonly);
+            files.extend(readwrite);
+            files.extend(pins);
+            Ok(Self {
+                request: prepared,
+                argv,
+                custody,
+                files,
+            })
+        })();
+        result.map_err(|cause| preparation_error(stage, cause))
+    }
+
+    /// Recover only this constructor's closed diagnostic stage, never its cause
+    /// text. An unrelated error cannot supply a stage or execution authority.
+    pub fn preparation_failure_stage(error: &io::Error) -> Option<OwnedWindowsPreparationStage> {
+        error
+            .get_ref()?
+            .downcast_ref::<OwnedWindowsPreparationError>()
+            .map(|error| error.stage)
+    }
+    /// Create the exact child in its owned Job without resuming its primary thread.
+    ///
+    /// This consumes all prepared inputs just like spawn, but a successful return
+    /// requires an explicit admit_and_resume call before any agent code runs.
+    /// Keep this exclusive owner until Stop/try_wait confirms native cleanup if
+    /// admission is omitted, cancelled or refused. Drop requests containment but
+    /// is not evidence of native wait completion. Setup failures before a usable
+    /// BaseChild is returned retain the existing spawn setup/cleanup behavior.
+    pub fn spawn_suspended(self, stdio: OwnedWindowsStdio) -> io::Result<OwnedPsecProcess> {
+        let mut runner = BaseContainerRunner::new();
+        runner
+            .spawn_owned_psec_suspended(
+                self.request.inner,
+                self.argv,
+                self.custody,
+                self.files,
+                stdio,
+            )
+            .map_err(|_: ScriptResponse| refused())
+    }
+
+    pub fn spawn(self, stdio: OwnedWindowsStdio) -> io::Result<OwnedPsecProcess> {
+        let mut runner = BaseContainerRunner::new();
+        runner
+            .spawn_owned_psec(
+                self.request.inner,
+                self.argv,
+                self.custody,
+                self.files,
+                stdio,
+            )
+            .map_err(|_: ScriptResponse| refused())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn owned_access_requires_exact_role_rights_without_host_mutation_rights() {
+        for stage in [
+            OwnedWindowsPreparationStage::InputShape,
+            OwnedWindowsPreparationStage::PayloadAccess,
+            OwnedWindowsPreparationStage::PayloadIdentity,
+            OwnedWindowsPreparationStage::CwdAccess,
+            OwnedWindowsPreparationStage::CwdIdentity,
+            OwnedWindowsPreparationStage::CwdPrivacy,
+            OwnedWindowsPreparationStage::CwdPath,
+            OwnedWindowsPreparationStage::RootPin,
+            OwnedWindowsPreparationStage::GrantAccess,
+            OwnedWindowsPreparationStage::GrantIdentity,
+            OwnedWindowsPreparationStage::GrantPath,
+            OwnedWindowsPreparationStage::GrantPin,
+            OwnedWindowsPreparationStage::PayloadPath,
+            OwnedWindowsPreparationStage::ArgvPolicy,
+            OwnedWindowsPreparationStage::PolicyFloor,
+            OwnedWindowsPreparationStage::PayloadCustody,
+        ] {
+            let error = preparation_error(
+                stage,
+                io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "fixed synthetic private cause",
+                ),
+            );
+            assert_eq!(
+                PreparedOwnedWindowsPsec::preparation_failure_stage(&error),
+                Some(stage)
+            );
+            assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+            assert_eq!(error.to_string(), "owned Windows PSEC preparation refused");
+            let payload = error
+                .get_ref()
+                .unwrap()
+                .downcast_ref::<OwnedWindowsPreparationError>()
+                .unwrap();
+            assert_eq!(payload.cause.to_string(), "fixed synthetic private cause");
+            assert!(std::error::Error::source(payload).is_some());
+        }
+        assert_eq!(
+            PreparedOwnedWindowsPsec::preparation_failure_stage(&io::Error::other("unclassified")),
+            None
+        );
+        assert!(access_allowed(0x120089, false, false));
+        assert!(access_allowed(0x1200a9, false, true));
+        assert!(access_allowed(0x12019f, true, false));
+        assert!(!access_allowed(0x120089, false, true));
+        for extra in [0x40, 0x10000, 0x40000, 0x80000, 0x01000000] {
+            assert!(!access_allowed(0x1200a9 | extra, false, true));
+            assert!(!access_allowed(0x12019f | extra, true, false));
+        }
+        for extra in [2, 4, 0x10, 0x100] {
+            assert!(!access_allowed(0x120089 | extra, false, false));
+        }
+    }
+}
